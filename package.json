{
  "name": "dsh-bsk-fetch",
  "version": "0.1.0",
  "icon": "./icon.svg",
  "description": "用 bsk 驱动真实浏览器爬取带验证码的网站。简单验证码（Cloudflare Turnstile 复选框）自动点过；复杂验证码（hCaptcha 图片点选、reCAPTCHA 网格、滑块拼图）通过视觉后端判读 + 点击/拖拽自动解，失败时退回人工兜底。暴露 bsk_fetch、bsk_pass_captcha、bsk_solve_captcha、bsk_doctor 四个工具。以 vcb-s.com 为例。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "selftest.mjs"
  ],
  "scripts": {
    "test": "node selftest.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "bsk",
    "captcha",
    "cloudflare",
    "turnstile",
    "hcaptcha",
    "recaptcha",
    "slider",
    "爬虫"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
